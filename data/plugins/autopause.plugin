[Core]
Name = Auto Pause
Module = autopause

[Documentation]
Author = Elio Esteves Duarte
Version = 0.2.0
Website =  https://github.com/eliostvs/tomate-gtk
Description = Pauses all running media players when the session ends
Notes = GTK4 drops legacy status icons; external systray plugins must stay GTK3 or migrate to non-GTK solutions.
